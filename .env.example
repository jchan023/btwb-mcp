# The session cookie itself lives in Keychain, not here - see README.md
# "Get your session cookie" for the manual method, or "Automatic cookie
# refresh" to have the server obtain and rotate it for you.

# Optional - only needed for automatic cookie refresh (see README
# "Automatic cookie refresh"). Your BTWB password itself is NOT stored here -
# it goes in Keychain instead, never in this file.
BTWB_EMAIL=

# Optional - per-request timeout in milliseconds (default 30000).
# BTWB_REQUEST_TIMEOUT_MS=30000
